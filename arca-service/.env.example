# --- Server ---
NODE_ENV=development
PORT=3001
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# --- Database ---
# Local Docker Postgres (see docker-compose.yml).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/arca

# --- Auth ---
JWT_SECRET=dev-insecure-jwt-secret-change-me
JWT_EXPIRES_IN=12h
COOKIE_NAME=arca_session
# Set to true when serving over HTTPS.
COOKIE_SECURE=false

# --- ARCA document storage (local filesystem for now) ---
STORAGE_DIR=./storage
SIGNED_LINK_SECRET=dev-insecure-signed-link-secret-change-me

# --- ARCA / AFIP WSFE emission (Phase 2) ---
# Issuer identity (Kyra SRL, Responsable Inscripto). CERT_PATH/KEY_PATH are
# filesystem paths to the .crt/.key PEM files (see arca-service/.gitignore).
# CUIT=20709019011
# CERT_PATH=./certs/kyra.crt
# KEY_PATH=./certs/kyra.key
# Sales point used exclusively for WSFE emission. Independent from any
# billing_entities.point_of_sale value stored in the DB.
# WSFE_PUNTO_VENTA=1
